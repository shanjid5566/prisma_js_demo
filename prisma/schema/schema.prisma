// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


/* ===========================
   ENUMS
   =========================== */
enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}
enum MosqueStatus {
  PENDING
  APPROVED
  REJECTED
}
enum MosqueMembershipType {
  IMAM
  BOARD_MEMBER
  EDUCATION_DIRECTOR
  OTHER
}
enum QuestionVisibility {
  PUBLIC_GROUP
  PRIVATE
}
enum QuestionStatus {
  PENDING
  CLAIMED
  ANSWERED
  CLOSED
}
enum ConsultationStatus {
  REQUESTED
  CLAIMED
  PROPOSED
  CONFIRMED
  COMPLETED
  CANCELLED
}
enum ConsultationSlotStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  EXPIRED
}
enum InstructorRole {
  TEACHER
  SCHOLAR
}
enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}
enum EnrollmentStatus {
  ACTIVE
  WAITLISTED
  DROPPED
  COMPLETED
}
enum ClassSessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}
enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}
enum LibraryContentType {
  ARTICLE
  AUDIO
  VIDEO
  PDF
}
enum LibraryVisibility {
  PUBLIC
  REGISTERED_ONLY
}




/* ===========================
   Models
   =========================== */


model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  gender       String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  // RBAC
  userRoles UserRole[]
  // Mosques
  mosqueMemberships MosqueUser[]
  mosquesApproved   Mosque[] @relation("MosqueApprovedBy")
  referralCodesCreated ReferralCode[]
  userReferrals UserReferral[]
  // Counseling
  questionsAsked      Question[]       @relation("QuestionAskedBy")
  questionClaims      QuestionClaim[]  @relation("QuestionClaimedBy")
  questionAnswers     QuestionAnswer[] @relation("QuestionAnsweredBy")
  consultationsAsStudent Consultation[] @relation("ConsultationStudent")
  consultationsAsScholar Consultation[] @relation("ConsultationScholar")
  consultationSlotsCreated ConsultationSlot[] @relation("ConsultationSlotCreatedBy")
  // Courses / classes
  coursesCreated    Course[]            @relation("CourseCreatedBy")
  courseInstructors CourseInstructor[]
  batchEnrollments  BatchEnrollment[]
  classSessionsCreated ClassSession[]   @relation("ClassSessionCreatedBy")
  lessonsSubmitted  Lesson[]            @relation("LessonSubmittedBy")
  lessonsReviewed   Lesson[]            @relation("LessonReviewedBy")
  // Library
  libraryItemsSubmitted LibraryItem[]   @relation("LibraryItemSubmittedBy")
  libraryItemsApproved  LibraryItem[]   @relation("LibraryItemApprovedBy")
  libraryItemAuthors    LibraryItemAuthor[]
  // Notifications/Audit
  notifications Notification[]
  auditLogs      AuditLog[]
  // user_roles.assigned_by
  roleAssignmentsMade UserRole[] @relation("UserRoleAssignedBy")
  @@map("users")
}
model Role {
  id   Int    @id @db.SmallInt
  code String @unique
  name String
  userRoles        UserRole[]
  rolePermissions  RolePermission[]
  @@map("roles")
}
model Permission {
  id   Int    @id @db.SmallInt
  code String @unique
  name String
  rolePermissions RolePermission[]
  @@map("permissions")
}
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     Int      @map("role_id") @db.SmallInt
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assigner User? @relation("UserRoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)
  @@id([userId, roleId])
  @@map("user_roles")
}
model RolePermission {
  roleId       Int @map("role_id") @db.SmallInt
  permissionId Int @map("permission_id") @db.SmallInt
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}
model Mosque {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  email      String       @unique
  phone      String?
  address    String?
  city       String?
  country    String?
  status     MosqueStatus @default(PENDING)
  approvedBy String?      @map("approved_by") @db.Uuid
  approvedAt DateTime?    @map("approved_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  approver      User?          @relation("MosqueApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  mosqueUsers   MosqueUser[]
  referralCodes ReferralCode[]
  @@map("mosques")
}
model MosqueUser {
  mosqueId        String               @map("mosque_id") @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  membershipType  MosqueMembershipType @map("membership_type")
  joinedAt        DateTime             @default(now()) @map("joined_at") @db.Timestamptz(6)
  mosque Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([mosqueId, userId])
  @@map("mosque_users")
}
model ReferralCode {
  id        String    @id @default(uuid()) @db.Uuid
  mosqueId  String    @map("mosque_id") @db.Uuid
  code      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  mosque        Mosque         @relation(fields: [mosqueId], references: [id], onDelete: Cascade)
  creator       User           @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  userReferrals UserReferral[]
  @@map("referral_codes")
}
model UserReferral {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  referralCodeId String   @map("referral_code_id") @db.Uuid
  appliedAt      DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  @@map("user_referrals")
}
model Question {
  id            String            @id @default(uuid()) @db.Uuid
  askedByUserId String?           @map("asked_by_user_id") @db.Uuid
  title         String?
  body          String
  visibility    QuestionVisibility
  status        QuestionStatus    @default(PENDING)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  askedBy User? @relation("QuestionAskedBy", fields: [askedByUserId], references: [id], onDelete: SetNull)
  claims  QuestionClaim[]
  answers QuestionAnswer[]
  @@index([status, createdAt(sort: Desc)])
  @@map("questions")
}
model QuestionClaim {
  id            String    @id @default(uuid()) @db.Uuid
  questionId    String    @map("question_id") @db.Uuid
  scholarUserId String    @map("scholar_user_id") @db.Uuid
  claimedAt     DateTime  @default(now()) @map("claimed_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  releasedAt    DateTime? @map("released_at") @db.Timestamptz(6)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  scholar  User     @relation("QuestionClaimedBy", fields: [scholarUserId], references: [id], onDelete: Restrict)
  @@index([questionId])
  @@index([scholarUserId])
  @@map("question_claims")
}
model QuestionAnswer {
  id               String   @id @default(uuid()) @db.Uuid
  questionId       String   @map("question_id") @db.Uuid
  answeredByUserId String   @map("answered_by_user_id") @db.Uuid
  answerBody       String   @map("answer_body")
  isFinal          Boolean  @default(true) @map("is_final")
  publishedAt      DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answeredBy User     @relation("QuestionAnsweredBy", fields: [answeredByUserId], references: [id], onDelete: Restrict)
  @@map("question_answers")
}
model Consultation {
  id            String             @id @default(uuid()) @db.Uuid
  studentUserId String             @map("student_user_id") @db.Uuid
  scholarUserId String?            @map("scholar_user_id") @db.Uuid
  topic         String?
  description   String?
  status        ConsultationStatus @default(REQUESTED)
  requestedAt   DateTime           @default(now()) @map("requested_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  student User  @relation("ConsultationStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  scholar User? @relation("ConsultationScholar", fields: [scholarUserId], references: [id], onDelete: SetNull)
  slots   ConsultationSlot[]
  @@index([status, requestedAt(sort: Desc)])
  @@map("consultations")
}
model ConsultationSlot {
  id             String                 @id @default(uuid()) @db.Uuid
  consultationId String                 @map("consultation_id") @db.Uuid
  startAt        DateTime               @map("start_at") @db.Timestamptz(6)
  endAt          DateTime               @map("end_at") @db.Timestamptz(6)
  meetingUrl     String?                @map("meeting_url")
  status         ConsultationSlotStatus @default(PROPOSED)
  createdBy      String                 @map("created_by") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  creator      User         @relation("ConsultationSlotCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  @@map("consultation_slots")
}
model Course {
  id          String      @id @default(uuid()) @db.Uuid
  title       String
  description String?
  language    String?
  isActive    Boolean     @default(true) @map("is_active")
  createdBy   String      @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator           User               @relation("CourseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  batches           Batch[]
  courseInstructors CourseInstructor[]
  @@map("courses")
}
model CourseInstructor {
  courseId          String            @map("course_id") @db.Uuid
  instructorUserId  String            @map("instructor_user_id") @db.Uuid
  role              InstructorRole
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor User   @relation(fields: [instructorUserId], references: [id], onDelete: Cascade)
  @@id([courseId, instructorUserId, role])
  @@map("course_instructors")
}
model Batch {
  id        String      @id @default(uuid()) @db.Uuid
  courseId  String      @map("course_id") @db.Uuid
  code      String      @unique
  capacity  Int         @default(15)
  startDate DateTime?   @map("start_date") @db.Date
  endDate   DateTime?   @map("end_date") @db.Date
  status    BatchStatus @default(UPCOMING)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batchEnrollments BatchEnrollment[]
  classSessions    ClassSession[]
  lessons          Lesson[]
  @@map("batches")
}
model BatchEnrollment {
  batchId           String           @map("batch_id") @db.Uuid
  studentUserId     String           @map("student_user_id") @db.Uuid
  enrollmentStatus  EnrollmentStatus @default(ACTIVE) @map("enrollment_status")
  enrolledAt        DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  waitlistRank      Int?             @map("waitlist_rank")
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  @@id([batchId, studentUserId])
  @@index([studentUserId, enrollmentStatus])
  @@map("batch_enrollments")
}
model ClassSession {
  id          String             @id @default(uuid()) @db.Uuid
  batchId     String             @map("batch_id") @db.Uuid
  title       String?
  startsAt    DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime           @map("ends_at") @db.Timestamptz(6)
  meetingUrl  String?            @map("meeting_url")
  recordingUrl String?           @map("recording_url")
  status      ClassSessionStatus @default(SCHEDULED)
  createdBy   String             @map("created_by") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  creator User  @relation("ClassSessionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  @@map("class_sessions")
}
model Lesson {
  id               String            @id @default(uuid()) @db.Uuid
  batchId          String            @map("batch_id") @db.Uuid
  title            String
  description      String?
  youtubeUrl       String?           @map("youtube_url")
  durationSeconds  Int?              @map("duration_seconds")
  sequenceNo       Int               @map("sequence_no")
  moderationStatus ModerationStatus  @default(PENDING) @map("moderation_status")
  submittedBy      String            @map("submitted_by") @db.Uuid
  reviewedBy       String?           @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  batch      Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  submitter  User        @relation("LessonSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict)
  reviewer   User?       @relation("LessonReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  lessonTags LessonTagMap[]
  @@unique([batchId, sequenceNo])
  @@index([batchId, moderationStatus, sequenceNo])
  @@map("lessons")
}
model LessonTag {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  lessonTagMap LessonTagMap[]
  @@map("lesson_tags")
}
model LessonTagMap {
  lessonId String @map("lesson_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid
  lesson Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tag    LessonTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([lessonId, tagId])
  @@map("lesson_tag_map")
}
model LibraryItem {
  id               String           @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  contentType      LibraryContentType @map("content_type")
  sourceUrl        String?          @map("source_url")
  thumbnailUrl     String?          @map("thumbnail_url")
  visibility       LibraryVisibility @default(PUBLIC)
  moderationStatus ModerationStatus @default(PENDING) @map("moderation_status")
  submittedBy      String           @map("submitted_by") @db.Uuid
  approvedBy       String?          @map("approved_by") @db.Uuid
  approvedAt       DateTime?        @map("approved_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  submitter User  @relation("LibraryItemSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict)
  approver  User? @relation("LibraryItemApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  categories LibraryItemCategory[]
  authors    LibraryItemAuthor[]
  @@index([moderationStatus, contentType, createdAt(sort: Desc)])
  @@map("library_items")
}
model LibraryCategory {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  slug String @unique
  libraryItemCategories LibraryItemCategory[]
  @@map("library_categories")
}
model LibraryItemCategory {
  libraryItemId String @map("library_item_id") @db.Uuid
  categoryId    String @map("category_id") @db.Uuid
  libraryItem LibraryItem     @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  category    LibraryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([libraryItemId, categoryId])
  @@map("library_item_categories")
}
model LibraryItemAuthor {
  libraryItemId String @map("library_item_id") @db.Uuid
  userId        String @map("user_id") @db.Uuid
  authorOrder   Int    @map("author_order")
  libraryItem LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([libraryItemId, userId])
  @@map("library_item_authors")
}
model Notification {
  id              String   @id @default(uuid()) @db.Uuid
  recipientUserId String   @map("recipient_user_id") @db.Uuid
  type            String
  title           String
  body            String?
  entityType      String?  @map("entity_type")
  entityId        String?  @map("entity_id") @db.Uuid
  isRead          Boolean  @default(false) @map("is_read")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt          DateTime? @map("read_at") @db.Timestamptz(6)
  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  @@index([recipientUserId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorUserId String? @map("actor_user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  payloadJson Json?   @map("payload_json")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@map("audit_logs")
}